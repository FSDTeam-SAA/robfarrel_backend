    {
      "name": "AI service callback (internal)",
      "description": "Called by the AI service, not the frontend. Only for testing signature handling.",
      "item": [
        {
          "name": "AI job callback (signed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Signs the body like the AI service: X-Signature = sha256=<HMAC-SHA256(secret, \"{timestamp}.{body}\")>",
                  "const secret = pm.collectionVariables.get('callbackSecret');",
                  "if (!secret) { throw new Error('Set the callbackSecret variable to AI_CALLBACK_SIGNING_SECRET'); }",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const signature = 'sha256=' + CryptoJS.HmacSHA256(timestamp + '.' + body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Signature-Timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'X-Signature', value: signature });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"{{runId}}\",\n  \"job_id\": \"manual-test\",\n  \"status\": \"completed\",\n  \"results\": {\n    \"note\": \"manual callback test\"\n  },\n  \"errors\": [],\n  \"usage\": [\n    {\n      \"provider\": \"anthropic\",\n      \"operation\": \"manual\",\n      \"input_tokens\": 1200,\n      \"output_tokens\": 300\n    }\n  ],\n  \"total_tokens\": 1500,\n  \"config_version\": \"manual\",\n  \"prompt_version\": \"manual\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ai/callback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "callback"
              ]
            },
            "description": "Public route authenticated by HMAC, not JWT. Set `callbackSecret` to the backend's `AI_CALLBACK_SIGNING_SECRET` and `runId` to a **running** async run. Completes that run and burns ceil(1500 / AI_TOKENS_PER_CREDIT) credits. A wrong or stale signature returns 401; a repeated callback is acknowledged without charging again."
          }
        }
      ]
    }
