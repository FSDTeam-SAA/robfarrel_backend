# Credit burn: 1 credit per this many AI tokens, rounded up per run
AI_TOKENS_PER_CREDIT=1000
# Minimum credit balance required to start an AI run
AI_MIN_CREDITS_TO_RUN=1
# Timeout for synchronous AI calls, in milliseconds
AI_REQUEST_TIMEOUT_MS=180000
# Reject callbacks whose signature timestamp is older than this many seconds
AI_CALLBACK_MAX_AGE_SECONDS=300
